NODE_ENV=production
HOST=0.0.0.0
PORT=7778
PUBLIC_URL=https://fight.example.com
POINTS_FILE=/app/data/points.json
TOKENS_FILE=/app/data/.tokens.json
AGENT_FILE=/app/data/.agent.json

# Optional platform overrides. Secrets should not be committed.
TWITCH_CHANNEL=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CHANNEL=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
